    <circle cx="40" cy="10" r="5" style="fill: var(--icona-accento, #ff8a80)"></circle>
    <line x1="20" y1="10" x2="14" y2="2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></line>
    <circle cx="13" cy="2" r="2.5" style="fill: var(--icona-accento, #ff8a80)"></circle>
</Svg>