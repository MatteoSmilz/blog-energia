---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icona from './icone/Icona.astro';
import { SERIE, type Serie, type InfoSerie } from '../lib/serie';
import { formattaData } from '../lib/date';

interface Props {
    titolo: string;
    href: string;
    pubblicato: Date;
    descrizione?: string;
    copertina?: { immagine: ImageMetadata };
    serie?: Serie;
    etichetta?: string;
    variante?: 'grande' | 'normale';
    priorita?: boolean;
}

const {
    titolo,
    href,
    pubblicato,
    descrizione,
    copertina,
    serie,
    etichetta,
    variante = 'normale',
    priorita = false,
} = Astro.props;

const info: InfoSerie | undefined = serie ? SERIE[serie] : undefined;
const testoEtichetta = etichetta ?? info?.nome;
const grande = variante == 'grande';
---

<a class:list={['scheda', variante]} href={href} data-serie={serie}>
    <div class="immagine">
        {copertina ? (
            <Image
                src={copertina.immagine}
                alt=""
                widths={grande ? [640, 1280] : [320, 640]}
                sizes={grande ? '(max-width: 900px) 100vw, 640px' : '(max-width: 700px) 100vw, 320px'}
                loading={priorita ? 'eager' : 'lazy'}
            />
        ) : (
            <div class="segnaposto">
                {info && <Icona nome={info.icona} dimensione={grande ? 120 : 72} />}
            </div>
        )}
    </div>
    <div class="testo">
        {testoEtichetta && (
            <span class="etichetta">
                {info && <Icona nome={info.icona} dimensione={18} />}
                {testoEtichetta}
            </span>
        )}
        <h3>{titolo}</h3>
        {descrizione && <p>{descrizione}</p>}
        <time datetime={pubblicato.toISOString()}>{formattaData(pubblicato)}</time>
    </div>
</a>

<style>
    .scheda {
        display: flex;
        flex-wrap: wrap;
        overflow: hidden;
        background: var(--superficie);
        border-radius: var(--raggio-grande);
        color: var(--testo);
        text-decoration: none;
        transition: background var(--durata);

        &:hover {
            background: var(--superficie-alta);
        }

        &:hover :global(img) {
            transform: scale(1.03);
        }
    }

    .immagine {
        position: relative;
        overflow: hidden;
        flex: 1 1 13rem;
        min-height: 13.75rem;
    }

    .grande .immagine {
        flex: 999 1 32rem;
        min-height: 23.75rem;
    }

    .immagine :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s;
    }

    .segnaposto {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 50%, var(--superficie-alta) 0%, var(--superficie) 72%);
        color: var(--serie);
    }

    .testo {
        flex: 1 1 14rem;
        display: flex;
        flex-direction: column;
        gap: var(--spazio-3);
        padding: var(--spazio-5) var(--spazio-6) var(--spazio-6);
    }

    .grande .testo {
        flex: 1 1 22rem;
        justify-content: center;
        gap: var(--spazio-4);
        padding: var(--spazio-7);
    }

    .etichetta {
        display: inline-flex;
        align-items: center;
        gap: var(--spazio-2);
        font-family: var(--font-titoli);
        font-size: var(--testo-piccolo);
        font-weight: 600;
        color: var(--serie);
    }

    h3 {
        margin: 0;
        font-size: var(--titolo-3);
    }

    .grande h3 {
        font-size: var(--titolo-2);
    }

    p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.55;
        color: var(--testo-tenue);
    }

    .grande p {
        font-size: var(--testo-base);
    }

    time {
        margin-top: auto;
        font-size: var(--testo-piccolo);
        color: var(--testo-tenue);
    }

    .grande time {
        margin-top: 0;
    }
</style>