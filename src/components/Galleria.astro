---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Elemento {
    src: ImageMetadata;
    alt: string;
    crediti: string;
}

interface Props {
    immagini: Elemento[];
}

const { immagini } = Astro.props;
const crediti = [...new Set(immagini.map((i) => i.crediti))].join(', ');
const haDidascalia = Astro.slots.has('default');
---

<figure class="galleria">
    <ul class="griglia">
        {immagini.map((i) => (
            <li>
                <Image
                    src={i.src}
                    alt={i.alt}
                    widths={[320, 640]}
                    sizes="(max-width: 600px) 50vw, 240px"
                />
            </li>
        ))}
    </ul>
    <figcaption>
        {haDidascalia && (
            <span class="didascalia">
                <slot />
            </span>
        )}
        <span class="crediti">Immagini: {crediti}</span>
    </figcaption>
</figure>

<style>
    .galleria {
        margin: var(--spazio-7) 0;
        counter-increment: figura;
    }

    .griglia {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
        gap: var(--spazio-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: var(--raggio-piccolo);
    }

    li :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    figcaption {
        display: flex;
        flex-direction: column;
        gap: var(--spazio-1);
        margin-top: var(--spazio-3);
        font-size: var(--testo-piccolo);
        line-height: 1.5;
        color: var(--testo-chiaro);
    }

    .didascalia::before {
        content: 'Figura ' counter(figura) '. ';
        font-family: var(--font-titoli);
        font-weight: 600;
        color: var(--serie);
    }

    .crediti {
        color: var(--testo-tenue);
    }
</style>
