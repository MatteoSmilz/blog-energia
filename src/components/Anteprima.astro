---
interface Props {
    titolo: string;
    href: string;
    data: Date;
    descrizione?: string;
}
const { titolo, href, data, descrizione } = Astro.props;
const dataLeggibile = data.toLocaleDateString('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
});
---

<a class="anteprima" href={href}>
    <time datetime={data.toISOString()}>{dataLeggibile}</time>
    <h3>{titolo}</h3>
    {descrizione && <p>{descrizione}</p>}
</a>

<style>
    .anteprima {
        display: block;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--bordo);
        border-radius: 0.75rem;
        color: inherit;
        text-decoration: none;
        transition: border-color 0.2s, transform 0.2s;

        &:hover {
            border-color: var(--accento);
            transform: translateY(-2px);
        }
    }

    time {
        font-size: 0.85rem;
        color: var(--testo-tenue);
    }

    h3 {
        margin: 0.25rem 0 0.5rem;
    }

    p {
        margin: 0;
        color: var(--testo-tenue);
    }
</style>