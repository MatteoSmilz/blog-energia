---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
    titolo: string;
    href: string;
    pubblicato: Date;
    descrizione?: string;
    copertina?: {
        immagine: ImageMetadata;
        alt: string;
    };
}
const { titolo, href, pubblicato, descrizione, copertina } = Astro.props;
const dataLeggibile = pubblicato.toLocaleDateString('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
});
---

<a class="anteprima" href={href}>
    {copertina && (
        <Image
            src={copertina.immagine}
            alt={copertina.alt}
            widths={[400, 800]}
            sizes="(max-width: 600px) 100vw, 400px"
        />
    )}
    <div class="testo">
        <time datetime={pubblicato.toISOString()}>{dataLeggibile}</time>
        <h3>{titolo}</h3>
        {descrizione && <p>{descrizione}</p>}
    </div>
</a>

<style>
    .anteprima {
        display: block;
        overflow: hidden;
        border: 1px solid var(--bordo);
        border-radius: 0.75rem;
        color: inherit;
        text-decoration: none;
        transition: border-color 0.2s, transform 0.2s;

        &:hover {
            border-color: var(--accento);
            transform: translateY(-2px);
        }
    }

    img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
    }

    .testo {
        padding: 1.25rem 1.5rem;
    }

    time {
        font-size: 0.85rem;
        color: var(--testo-tenue);
    }

    h3 {
        margin: 0.25rem 0 0.5rem;
    }

    p {
        margin: 0;
        color: var(--testo-tenue);
    }
</style>