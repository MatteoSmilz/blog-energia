---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';

interface Props {
    titolo: string;
    sottotitolo?: string;
    pubblicato: Date;
    copertina?: {
        immagine: ImageMetadata;
        alt: string;
        crediti: string;
        link?: string;
    };
}
const { titolo, sottotitolo, pubblicato, copertina } = Astro.props;
---

<Base titolo={titolo}>
    <article>
        <h1>{titolo}</h1>
        {sottotitolo && <p class="sottotitolo">{sottotitolo}</p>}
        <time datetime={pubblicato.toISOString()}>
            {pubblicato.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {copertina && (
            <figure class="copertina">
                <Image
                    src={copertina.immagine}
                    alt={copertina.alt}
                    widths={[800, 1600]}
                    sizes="(max-width: 900px) 100vw, 900px"
                    loading="eager"
                />
                <figcaption>
                    Immagine: {copertina.link ? <a href={copertina.link}>{copertina.crediti}</a> : copertina.crediti}
                </figcaption>
            </figure>
        )}
        <slot />
    </article>
</Base>

<style>
    .copertina {
        margin: 2rem 0;
    }

    .copertina img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0.75rem;
    }

    figcaption {
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: var(--testo-tenue);
    }
</style>