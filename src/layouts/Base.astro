---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import Intestazione from '../components/Intestazione.astro';
import PiePagina from '../components/PiePagina.astro';
import { url } from '../lib/url';

interface Props {
    titolo: string;
    headerSovrapposto?: boolean;
    paginaLarga?: boolean;
}

const { titolo, headerSovrapposto = false, paginaLarga = false } = Astro.props;
const NOME = 'Le centrali della natura';
const titoloPagina = titolo === NOME ? NOME : `${titolo} · ${NOME}`;
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href={url('favicon.svg')} />
        <Font cssVariable="--font-bricolage" preload />
        <Font cssVariable="--font-literata" />
        <title>{titoloPagina}</title>
    </head>
    <body>
        <Intestazione sovrapposta={headerSovrapposto} />
        <slot name="hero" />
        <main id="contenuto" tabindex="-1" class:list={[paginaLarga && 'larga']}>
            <slot />
        </main>
        <PiePagina />
    </body>
</html>

<style>
    .larga {
        max-width: 80rem;
    }

    main:focus {
        outline: none;
    }
</style>