---
import Base from '../../layouts/Base.astro';
import Anteprima from '../../components/Anteprima.astro';
import { SERIE, NOMI_SERIE } from '../../lib/serie';
import { getArticoli } from '../../lib/articoli';
import { url } from '../../lib/url';

const articoli = await getArticoli();
const gruppi = NOMI_SERIE
    .map((serie) => ({ serie, articoli: articoli.filter((a) => a.data.serie === serie) }))
    .filter((gruppo) => gruppo.articoli.length > 0);
---

<Base titolo="Articoli">
    <h1>Articoli</h1>
    {gruppi.map(({ serie, articoli }) => (
        <section>
            <h2><a href={url(`serie/${serie}`)}>{SERIE[serie].nome}</a></h2>
            <p class="descrizione">{SERIE[serie].descrizione}</p>
            <div class="griglia">
                {articoli.map((a) => (
                    <Anteprima
                        titolo={a.data.titolo}
                        href={url(`articoli/${a.id}`)}
                        pubblicato={a.data.pubblicato}
                        descrizione={a.data.descrizione}
                        copertina={a.data.copertina}
                    />
                ))}
            </div>
        </section>
    ))}
</Base>

<style>
    section {
        margin-top: 3rem;
    }

    .descrizione {
        color: var(--testo-tenue);
    }

    .griglia {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
</style>