---
import { render } from 'astro:content';
import Articolo from '../../layouts/Articolo.astro';
import { getArticoli } from '../../lib/articoli';

export async function getStaticPaths() {
    const articoli = await getArticoli();
    return articoli.map((articolo) => ({
        params: { slug: articolo.id },
        props: { articolo },
    }));
}

const { articolo } = Astro.props;
const { Content } = await render(articolo);
const { titolo, sottotitolo, pubblicato, copertina } = articolo.data;
---

<Articolo titolo={titolo} sottotitolo={sottotitolo} pubblicato={pubblicato} copertina={copertina}>
    <Content />
</Articolo>