---
import { render } from 'astro:content';
import Articolo from '../../layouts/Articolo.astro';
import { getArticoli, getQuintePerArticolo } from '../../lib/articoli';
import { tempoDiLettura } from '../../lib/lettura';
import { url } from '../../lib/url';

export async function getStaticPaths() {
    const articoli = await getArticoli();
    return articoli.map((articolo) => ({
        params: { slug: articolo.id },
        props: { articolo },
    }));
}

const { articolo } = Astro.props;
const { Content, headings } = await render(articolo);
const { titolo, sottotitolo, pubblicato, aggiornato, copertina, tag, serie } = articolo.data;

const quinte = await getQuintePerArticolo(articolo.id);
const minuti = tempoDiLettura(articolo.body ?? '');

const dellaSerie = (await getArticoli()).filter((a) => a.data.serie === serie).reverse();
const posizione = dellaSerie.findIndex((a) => a.id === articolo.id);
const voce = (i: number) => {
    const a = dellaSerie[i];
    return a ? { titolo: a.data.titolo, href: url(`articoli/${a.id}`) } : undefined;
};
---

<Articolo
    titolo={titolo}
    sottotitolo={sottotitolo}
    pubblicato={pubblicato}
    aggiornato={aggiornato}
    copertina={copertina}
    tag={tag}
    serie={serie}
    intestazioni={headings}
    minuti={minuti}
    precedente={voce(posizione - 1)}
    successivo={voce(posizione + 1)}
>
    <Content />
    {quinte.length > 0 && (
        <aside class="quinte">
            <h2>Dietro le quinte</h2>
            <ul>
                {quinte.map((q) => (
                    <li>
                        <a href={url(`dietro-le-quinte/${q.id}`)}>{q.data.titolo}</a>
                    </li>
                ))}
            </ul>
        </aside>
    )}
</Articolo>

<style>
    .quinte {
        margin-top: var(--spazio-8);
        padding: var(--spazio-5) var(--spazio-6);
        border: 1px solid var(--bordo);
        border-radius: var(--raggio);

        & h2 {
            margin: 0;
            font-size: var(--titolo-3);
        }

        & ul {
            margin: var(--spazio-3) 0 0;
            padding: 0;
            list-style: none;
        }

        & a {
            color: var(--serie);
        }
    }
</style>
