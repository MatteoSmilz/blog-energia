---
import Base from '../../layouts/Base.astro';
import { getArticoli, raggruppaPerTag } from '../../lib/articoli';
import { url } from '../../lib/url';

const gruppi = [...raggruppaPerTag(await getArticoli())].sort(
    ([, a], [, b]) => b.articoli.length - a.articoli.length || a.nome.localeCompare(b.nome, 'it'),
);
---

<Base titolo="Tutti i tag">
    <h1>Tutti i tag</h1>
    <ul class="tag">
        {gruppi.map(([chiave, gruppo]) => (
            <li>
                <a href={url(`tag/${chiave}`)}>{gruppo.nome}</a>
                <span>{gruppo.articoli.length}</span>
            </li>
        ))}
    </ul>
</Base>

<style>
    .tag {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0;
        list-style: none;
    }

    .tag li {
        display: flex;
        gap: 0.4rem;
        padding: 0.4rem 0.9rem;
        border: 1px solid var(--bordo);
        border-radius: 999px;
    }

    .tag span {
        color: var(--testo-tenue);
    }
</style>
