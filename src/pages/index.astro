---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const articoli = (await getCollection('articoli', ({ data }) => !data.bozza))
    .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
---

<Base titolo="Blog sull'energia">
    <h1>Blog sull'energia</h1>
    <ul>
        {articoli.map((a) => (
            <li><a href={url(`articoli/${a.id}`)}>{a.data.titolo}</a></li>
        ))}
    </ul>
</Base>