---
import Base from '../layouts/Base.astro';
import Anteprima from '../components/Anteprima.astro';
import { getArticoli, scegliInEvidenza } from '../lib/articoli';
import { url } from '../lib/url';

const articoli = await getArticoli();
const inEvidenza = scegliInEvidenza(articoli);
const altri = articoli.filter((a) => a !== inEvidenza);
---

<Base titolo="Le centrali della natura">
    <h1>Le centrali della natura</h1>
    {inEvidenza && (
        <Anteprima
            titolo={inEvidenza.data.titolo}
            href={url(`articoli/${inEvidenza.id}`)}
            pubblicato={inEvidenza.data.pubblicato}
            descrizione={inEvidenza.data.descrizione}
        />
    )}
    {altri.map((a) => (
        <Anteprima
            titolo={a.data.titolo}
            href={url(`articoli/${a.id}`)}
            pubblicato={a.data.pubblicato}
            descrizione={a.data.descrizione}
            copertina={a.data.copertina}
        />
    ))}
</Base>