---
import Base from '../../layouts/Base.astro';
import Scheda from '../../components/Scheda.astro';
import { getRelazioni } from '../../lib/articoli';
import { url } from '../../lib/url';

const relazioni = await getRelazioni();
---

<Base titolo="Relazioni di laboratorio">
    <h1>Relazioni di laboratorio</h1>
    {relazioni.length === 0 ? (
        <p>Le prime relazioni arriveranno presto.</p>
    ) : (
        <div class="griglia">
            {relazioni.map((r) => (
                <Scheda
                    titolo={r.data.titolo}
                    href={url(`relazioni/${r.id}`)}
                    pubblicato={r.data.pubblicato}
                    descrizione={r.data.descrizione}
                    copertina={r.data.copertina}
                    etichetta={r.data.materia ?? 'Relazione di laboratorio'}
                />
            ))}
        </div>
    )}
</Base>

<style>
    .griglia {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
</style>