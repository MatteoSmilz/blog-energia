---
import { getCollection, render } from 'astro:content';
import Articolo from '../../layouts/Articolo.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
    const relazioni = await getCollection('relazioni', ({ data }) => !data.bozza);
    return relazioni.map((relazione) => ({
        params: { slug: relazione.id },
        props: { relazione },
    }));
}

const { relazione } = Astro.props;
const { Content } = await render(relazione);
const { titolo, data, pdf } = relazione.data;
---

<Articolo titolo={titolo} data={data}>
    <Content />
    {pdf && <PdfViewer src={url(pdf)} />}
</Articolo>