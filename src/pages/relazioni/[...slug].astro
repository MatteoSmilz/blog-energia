---
import { render } from 'astro:content';
import Articolo from '../../layouts/Articolo.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import { getRelazioni } from '../../lib/articoli';
import { url } from '../../lib/url';

export async function getStaticPaths() {
    const relazioni = await getRelazioni();
    return relazioni.map((relazione) => ({
        params: { slug: relazione.id },
        props: { relazione },
    }));
}

const { relazione } = Astro.props;
const { Content } = await render(relazione);
const { titolo, pubblicato, copertina, pdf } = relazione.data;
---

<Articolo titolo={titolo} pubblicato={pubblicato} copertina={copertina}>
    <Content />
    {pdf && <PdfViewer src={url(pdf)} />}
</Articolo>